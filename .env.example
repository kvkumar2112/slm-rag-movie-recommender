# Copy to config-local.env (or .env); both are gitignored. Fill in what you need.

# MongoDB long-term store
MONGO_URI=mongodb://localhost:27017
MONGO_DB=movie_rag

# TMDb: "API Read Access Token" from https://www.themoviedb.org/settings/api (preferred),
# or the shorter v3 "API Key" in TMDB_API_KEY.
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# Teacher LLM for generate-data / enrich
OPENAI_API_KEY=
